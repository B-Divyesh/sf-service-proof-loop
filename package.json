{
  "name": "service-proof-loop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json",
    "lint": "cargo fmt --all -- --check && cargo clippy --all-targets --all-features -- -D warnings",
    "test": "npm run typecheck && npm run test:deployment && playwright test",
    "test:deployment": "node --test tests/deployment-topology.test.mjs",
    "test:claims": "playwright test --grep @claim",
    "test:a11y": "playwright test --grep @a11y",
    "test:live": "node scripts/verify-live.mjs",
    "test:all": "cargo test --all-targets && npm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  }
}
