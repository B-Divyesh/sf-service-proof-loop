{
  "deployment_class": "container",
  "deploy_command": "./scripts/deploy-container.sh",
  "resource_group": "sociobot",
  "environment": "factory-env",
  "app_name": "sf-service-proof-loop",
  "state_backend": "durable-single-writer-sqlite",
  "data_dir": "/data",
  "storage_name": "service-proof-loop-data",
  "storage_mount": "/data",
  "active_revisions_mode": "Single",
  "rollout": {
    "drain_writers": true
  },
  "scale": {
    "min_replicas": 1,
    "max_replicas": 1
  }
}
